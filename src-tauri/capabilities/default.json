{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-close",
    "sql:allow-execute",
    "sql:allow-load",
    "sql:allow-select",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:scope-appdata",
    "fs:scope-appdata-recursive",
    "fs:allow-appdata-write",
    "fs:allow-appdata-read",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$APPDATA/signatures/**"
        },
        {
          "path": "$APPDATA/signatures/*"
        }
      ]
    },
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message"
  ]
}
