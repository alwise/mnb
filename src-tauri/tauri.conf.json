{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MAN NO BE GOD COMPANY LIMITED",
  "version": "0.1.0",
  "identifier": "com.mnb.receiptmanager",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "MAN NO BE GOD COMPANY LIMITED",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Alwise Studio",
    "targets": [
      "msi",
      "nsis",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/alwise/mnb/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMzNDY1NjhEQTQyRjJGM0MKUldROEx5K2tqVlpHdzRoSHpsSUw0VTlOVW1GUmkxUTQ3cDZ6Ukw5T2FJeEovb0pTNzAxNnl0K0IK"
    }
  }
}